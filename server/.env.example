# Copy to .env. Path is relative to the server/ folder.
DATABASE_URL="file:./prisma/dev.db"
PORT=3001
# Proxies whose X-Forwarded-For header is trusted for the client IP. Either a
# comma-separated list of addresses/subnets (e.g. "loopback, 10.0.0.0/8"), a hop
# count (e.g. 1), or true/false. Defaults to loopback, which covers the Vite dev
# proxy. Set this when deploying behind a reverse proxy.
# TRUST_PROXY="loopback"

# Better Auth. The URL the browser uses to reach the app (the Vite dev server
# locally, since it proxies /api). The secret signs session cookies; generate
# one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# The server won't start until it's set (at least 32 characters).
BETTER_AUTH_URL="http://localhost:5173"
BETTER_AUTH_SECRET=""
# Other origins allowed to sign in, comma-separated, `*` wildcards allowed.
# For testing on your phone over the LAN: TRUSTED_ORIGINS="http://192.168.*.*:5173"
# TRUSTED_ORIGINS=""
