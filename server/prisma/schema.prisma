generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// SQLite for local development; switch provider (and the driver adapter in
// src/db.ts) to PostgreSQL when deploying. The URL lives in prisma.config.ts.
datasource db {
  provider = "sqlite"
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

// The cookie holds a random token; only its SHA-256 hash is stored here.
model Session {
  id        String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}
